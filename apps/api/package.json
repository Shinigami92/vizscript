{
  "name": "@vizscript/api",
  "version": "0.0.0",
  "private": true,
  "description": "vizscript API (NestJS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.mjs\"",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/main.mjs",
    "migrate": "node-pg-migrate --envPath ../../.env -m migrations -j ts",
    "ts-check": "tsc"
  },
  "dependencies": {
    "@fastify/cookie": "~11.1.5",
    "@nestjs/common": "~12.4.2",
    "@nestjs/core": "~12.4.2",
    "@nestjs/platform-fastify": "~12.4.2",
    "@octokit/rest": "~22.0.1",
    "@vizscript/api-contract": "workspace:*",
    "fastify": "~5.12.8",
    "kysely": "~0.29.8",
    "node-pg-migrate": "~9.0.0",
    "pg": "~8.23.1",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@types/pg": "8.23.1",
    "tsdown": "0.23.7"
  }
}
