# Copy to .env and adjust.

# Used by the API (local dev) and node-pg-migrate.
DATABASE_URL=postgres://vizscript:vizscript@localhost:5432/vizscript

# Secret for session/token encryption. At least 32 characters.
# Generate one with: openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me

# Set to true when served over HTTPS.
SECURE_COOKIES=false

# API port (the web dev server proxies /api to it).
PORT=3333
